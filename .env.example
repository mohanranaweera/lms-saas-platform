# This file contains examples only.
# Never store real credentials in this file.

# Provisions the Postgres container itself (read by infrastructure/docker-compose.dev.yml
# via infrastructure/.env.dev - see that file, not this one, for the value actually used).
POSTGRES_DB=lms_dev
POSTGRES_USER=lms_app
POSTGRES_PASSWORD=replace_for_local_development

# Read by the Spring Boot app (backend/src/main/resources/application-local.yml) to connect
# to that same Postgres container. Kept in sync with the POSTGRES_* values above for local
# dev; DB_URL's host/port must match docker-compose.dev.yml's Postgres port mapping (5433).
DB_URL=jdbc:postgresql://localhost:5433/lms_dev
DB_USERNAME=lms_app
DB_PASSWORD=replace_for_local_development

REDIS_HOST=localhost
REDIS_PORT=6379

BACKEND_PORT=8080
FRONTEND_PORT=3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

MAIL_HOST=localhost
MAIL_PORT=1025
# Only needed for a real (non-local) deployment - backend/src/main/resources/application.yml
# defaults MAIL_HOST/MAIL_PORT to Google's smtp.gmail.com:587 when these are unset, so
# username/password are all that's actually required to go live with Gmail. MAIL_USERNAME is
# the full sending Gmail/Google Workspace address; MAIL_PASSWORD MUST be a 16-character Google
# "App Password" (Google Account > Security > 2-Step Verification > App passwords) - the
# regular account password is rejected for SMTP auth. Leave both blank for local dev (MailHog/
# Mailpit needs no auth).
MAIL_USERNAME=
MAIL_PASSWORD=
# Should match MAIL_USERNAME unless a verified Gmail "Send As" alias is configured - Gmail
# rejects or silently rewrites a From address that doesn't match the authenticated account.
MAIL_FROM_ADDRESS=

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=replace_for_local_development
OBJECT_STORAGE_SECRET_KEY=replace_for_local_development
