# This file contains examples only.
# Never store real credentials in this file.
#
# Mirrors the env vars backend/src/main/resources/application-local.yml reads.
# Values below match infrastructure/docker-compose.dev.yml's local defaults.

DB_URL=jdbc:postgresql://localhost:5433/lms_dev
DB_USERNAME=lms_app
DB_PASSWORD=change_this_local_password

REDIS_HOST=localhost
REDIS_PORT=6379

MAIL_HOST=localhost
MAIL_PORT=1025

BACKEND_PORT=8080

# Never store a real JWT signing secret in this file - this is a clearly-fake,
# dev-only placeholder (HS256, ADR-007). Every non-local environment must set
# its own real JWT_SECRET (>= 32 bytes) via actual environment configuration.
JWT_SECRET=dev-only-placeholder-secret-change-me-before-any-real-deployment-32bytes+

# PAY-GW-01 (ADR-017) tenant PayHere accounts. Base64 of exactly 32 bytes; encrypts
# tenant merchant secrets at rest. Never commit a real key. Empty = online payment
# configuration fails closed (503).
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
# Public URL PayHere calls back (must be reachable from the internet, e.g. an ngrok
# tunnel locally): https://<host>/api/v1/integrations/webhooks/payhere
PAYHERE_NOTIFY_URL=
# Tenant storefront origin; {subdomain} is filled from the tenant record.
PAYHERE_RETURN_URL_TEMPLATE=http://{subdomain}.lms.test:3000

# MEDIA-INT-01 (ADR-018) media & meeting providers. Every value empty = that provider shows as
# "Unavailable" and connecting fails closed. Never commit real values. Setup steps:
# docs/architecture/integration-architecture.md section 9.
# Base64 of exactly 32 bytes; encrypts teacher OAuth tokens and DynTube/Bunny API keys.
MEDIA_CREDENTIALS_ENCRYPTION_KEY=
# Public origin serving /api/v1/integrations/oauth/{provider}/callback (the redirect URI
# registered with every provider app).
MEDIA_OAUTH_CALLBACK_BASE_URL=
# Tenant site origin the teacher returns to; {subdomain} is filled from the tenant record.
MEDIA_TENANT_URL_TEMPLATE=http://{subdomain}.lms.test:3000
# Neutral page for an expired/used connection link.
MEDIA_OAUTH_ERROR_URL=http://lms.test:3000/integration-error
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
VIMEO_OAUTH_CLIENT_ID=
VIMEO_OAUTH_CLIENT_SECRET=
