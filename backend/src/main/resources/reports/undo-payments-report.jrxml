 <field name="rowNo" class="java.lang.String"/><field name="student" class="java.lang.String"/><field name="indexNumber" class="java.lang.String"/><field name="course" class="java.lang.String"/><field name="reason" class="java.lang.String"/><field name="date" class="java.lang.String"/><field name="amount" class="java.lang.String"/>
 <title height="100"><element kind="rectangle" x="0" y="0" width="786" height="50" backcolor="#1F2937" mode="Opaque"><pen lineWidth="0.0"/></element><element kind="textField" x="14" y="6" width="750" height="38" forecolor="#FFFFFF" fontName="LMS Sans" fontSize="15" bold="true" textAdjust="StretchHeight"><expression><![CDATA["Undo Payments Report\n" + $P{INSTITUTE}]]></expression></element><element kind="textField" x="0" y="57" width="380" height="13" style="Muted"><expression><![CDATA["Date range: " + $P{DATE_RANGE}]]></expression></element><element kind="textField" x="395" y="57" width="391" height="13" style="Muted"><expression><![CDATA[$P{GENERATED}]]></expression></element><element kind="frame" x="0" y="74" width="185" height="26" backcolor="#F9FAFB" mode="Opaque"><element kind="staticText" x="8" y="4" width="169" height="10" style="Header"><text><![CDATA[TOTAL UNDO PAYMENTS]]></text></element><element kind="textField" x="8" y="13" width="169" height="12" fontName="LMS Sans" fontSize="12" bold="true"><expression><![CDATA[$P{TOTAL}]]></expression></element></element><element kind="textField" x="200" y="82" width="250" height="14" style="Muted"><expression><![CDATA["Total amount: LKR " + $P{TOTAL_AMOUNT}]]></expression></element></title>
 <columnHeader height="24"><element kind="frame" x="0" y="2" width="786" height="20" backcolor="#E5E7EB" mode="Opaque"><element kind="staticText" x="3" y="1" width="24" height="18" style="Header" hTextAlign="Right"><text><![CDATA[#]]></text></element><element kind="staticText" x="35" y="1" width="150" height="18" style="Header"><text><![CDATA[STUDENT]]></text></element><element kind="staticText" x="190" y="1" width="50" height="18" style="Header"><text><![CDATA[INDEX]]></text></element><element kind="staticText" x="245" y="1" width="180" height="18" style="Header"><text><![CDATA[COURSE]]></text></element><element kind="staticText" x="430" y="1" width="120" height="18" style="Header"><text><![CDATA[REASON]]></text></element><element kind="staticText" x="555" y="1" width="110" height="18" style="Header"><text><![CDATA[DATE]]></text></element><element kind="staticText" x="670" y="1" width="110" height="18" style="Header" hTextAlign="Right"><text><![CDATA[AMOUNT (LKR)]]></text></element></element></columnHeader>
 <detail><band height="24" splitType="Stretch"><element kind="frame" x="0" y="0" width="786" height="24"><box><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><element kind="textField" x="3" y="1" width="24" height="20" hTextAlign="Right"><expression><![CDATA[$F{rowNo}]]></expression></element><element kind="textField" x="35" y="1" width="150" height="20" textAdjust="StretchHeight"><expression><![CDATA[$F{student}]]></expression></element><element kind="textField" x="190" y="1" width="50" height="20"><expression><![CDATA[$F{indexNumber}]]></expression></element><element kind="textField" x="245" y="1" width="180" height="20" textAdjust="StretchHeight"><expression><![CDATA[$F{course}]]></expression></element><element kind="textField" x="430" y="1" width="120" height="20" textAdjust="StretchHeight"><expression><![CDATA[$F{reason}]]></expression></element><element kind="textField" x="555" y="1" width="110" height="20"><expression><![CDATA[$F{date}]]></expression></element><element kind="textField" x="670" y="1" width="110" height="20" hTextAlign="Right"><expression><![CDATA[$F{amount}]]></expression></element></element></band></detail>
