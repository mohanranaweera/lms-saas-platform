<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="undo-payments-report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="22" bottomMargin="22" whenNoDataType="AllSectionsNoDetail">
 <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks.lms" value="sinhala,tamil"/>
