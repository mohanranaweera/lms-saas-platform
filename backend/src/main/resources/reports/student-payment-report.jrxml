			</element>
		</band>
	</detail>
	<pageFooter height="22">
		<element kind="line" x="0" y="2" width="786" height="1" forecolor="#D1D5DB"/>
		<element kind="textField" x="0" y="6" width="640" height="14" style="Muted" textAdjust="ScaleFont">
			<expression><![CDATA[$P{FOOTER_TEXT}]]></expression>
		</element>
		<element kind="textField" x="640" y="6" width="110" height="14" style="Muted" hTextAlign="Right">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression>
		</element>
		<element kind="textField" x="750" y="6" width="36" height="14" style="Muted" evaluationTime="Report">
			<expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
	<summary height="38" splitType="Prevent">
		<element kind="staticText" x="0" y="4" width="786" height="16" fontSize="10.0" forecolor="#6B7280" hTextAlign="Center" removeLineWhenBlank="true">
			<printWhenExpression><![CDATA[$P{EMPTY}]]></printWhenExpression>
			<text><![CDATA[No payments match these filters]]></text>
		</element>
		<element kind="textField" x="0" y="22" width="786" height="14" style="Muted" textAdjust="StretchHeight" positionType="Float">
			<expression><![CDATA["Notes:\n" + $P{NOTES}]]></expression>
		</element>
	</summary>
</jasperReport>
