					</element>
					<element kind="textField" x="728" y="0" width="54" height="18" bold="true" hTextAlign="Right" vTextAlign="Middle" textAdjust="ScaleFont" stretchType="ContainerHeight">
						<expression><![CDATA[$F{g1Fee}]]></expression>
					</element>
				</element>
				<element kind="frame" x="0" y="0" width="786" height="18" backcolor="#EFF6FF" mode="Opaque">
					<printWhenExpression><![CDATA[$P{HAS_POSTAGE}]]></printWhenExpression>
					<box>
						<topPen lineWidth="0.75" lineColor="#9CA3AF"/>
					</box>
					<element kind="textField" x="6" y="0" width="584" height="18" bold="true" vTextAlign="Middle" textAdjust="StretchHeight">
						<box topPadding="3" bottomPadding="3"/>
						<expression><![CDATA[$F{g1Label}]]></expression>
					</element>
					<element kind="textField" x="598" y="0" width="64" height="18" bold="true" hTextAlign="Right" vTextAlign="Middle" textAdjust="ScaleFont" stretchType="ContainerHeight">
						<expression><![CDATA[$F{g1Amount}]]></expression>
