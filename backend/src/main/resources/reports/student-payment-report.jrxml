					</element>
					<element kind="staticText" x="556" y="0" width="92" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[DATE]]></text>
					</element>
					<element kind="textField" x="656" y="0" width="64" height="18" style="ColHeader" hTextAlign="Right" vTextAlign="Middle">
						<expression><![CDATA[$F{amountHeader}]]></expression>
					</element>
					<element kind="staticText" x="728" y="0" width="54" height="18" style="ColHeader" hTextAlign="Right" vTextAlign="Middle">
						<text><![CDATA[SERVICE FEE]]></text>
					</element>
				</element>
				<element kind="frame" x="0" y="2" width="786" height="18" backcolor="#E5E7EB" mode="Opaque">
					<printWhenExpression><![CDATA[$P{HAS_POSTAGE}]]></printWhenExpression>
					<element kind="staticText" x="4" y="0" width="20" height="18" style="ColHeader" hTextAlign="Right" vTextAlign="Middle">
						<text><![CDATA[#]]></text>
					</element>
					<element kind="staticText" x="32" y="0" width="36" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[INDEX]]></text>
					</element>
					<element kind="staticText" x="76" y="0" width="112" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[STUDENT]]></text>
					</element>
					<element kind="staticText" x="196" y="0" width="112" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[COURSE]]></text>
					</element>
					<element kind="staticText" x="316" y="0" width="88" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[REASON]]></text>
					</element>
					<element kind="staticText" x="412" y="0" width="78" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[METHOD]]></text>
					</element>
					<element kind="staticText" x="498" y="0" width="92" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[DATE]]></text>
					</element>
					<element kind="textField" x="598" y="0" width="64" height="18" style="ColHeader" hTextAlign="Right" vTextAlign="Middle">
						<expression><![CDATA[$F{amountHeader}]]></expression>
					</element>
					<element kind="staticText" x="670" y="0" width="54" height="18" style="ColHeader" hTextAlign="Right" vTextAlign="Middle">
						<text><![CDATA[SERVICE FEE]]></text>
					</element>
					<element kind="staticText" x="732" y="0" width="50" height="18" style="ColHeader" hTextAlign="Right" vTextAlign="Middle">
						<text><![CDATA[POSTAGE]]></text>
					</element>
				</element>
			</band>
		</groupHeader>
	</group>
	<group name="g1" minHeightToStartNewPage="48">
