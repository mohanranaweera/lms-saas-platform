	<field name="postage" class="java.lang.String"/>
	<field name="g1Show" class="java.lang.Boolean"/>
	<field name="g2Show" class="java.lang.Boolean"/>
	<group name="section" minHeightToStartNewPage="160">
		<expression><![CDATA[$F{sectionKey}]]></expression>
		<groupHeader>
			<band height="96">
				<element kind="textField" x="0" y="4" width="786" height="16" fontSize="11.0" bold="true">
					<expression><![CDATA[$F{sectionTitle}]]></expression>
				</element>
				<element kind="frame" x="0" y="24" width="254" height="50" backcolor="#F9FAFB" mode="Opaque">
					<box>
						<leftPen lineWidth="3.0" lineColor="#2563EB"/>
					</box>
					<element kind="staticText" x="12" y="7" width="234" height="12" style="CardLabel">
						<text><![CDATA[TOTAL AMOUNT (COURSE PAYMENTS)]]></text>
					</element>
					<element kind="textField" x="12" y="22" width="234" height="22" style="CardValue" textAdjust="ScaleFont">
						<expression><![CDATA[$F{kpiTotal}]]></expression>
					</element>
				</element>
				<element kind="frame" x="266" y="24" width="254" height="50" backcolor="#F9FAFB" mode="Opaque">
					<box>
						<leftPen lineWidth="3.0" lineColor="#16A34A"/>
					</box>
					<element kind="staticText" x="12" y="7" width="234" height="12" style="CardLabel">
						<text><![CDATA[TOTAL STUDENTS]]></text>
					</element>
					<element kind="textField" x="12" y="22" width="234" height="22" style="CardValue" textAdjust="ScaleFont">
						<expression><![CDATA[$F{kpiStudents}]]></expression>
					</element>
				</element>
				<element kind="frame" x="532" y="24" width="254" height="50" backcolor="#F9FAFB" mode="Opaque">
					<box>
						<leftPen lineWidth="3.0" lineColor="#7C3AED"/>
					</box>
					<element kind="staticText" x="12" y="7" width="234" height="12" style="CardLabel">
						<text><![CDATA[TOTAL PAYMENTS]]></text>
					</element>
					<element kind="textField" x="12" y="22" width="234" height="22" style="CardValue" textAdjust="ScaleFont">
						<expression><![CDATA[$F{kpiPayments}]]></expression>
					</element>
				</element>
				<element kind="textField" x="0" y="80" width="786" height="12" style="Muted" textAdjust="StretchHeight">
					<expression><![CDATA[$F{summaryLines}]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="4"/>
		</groupFooter>
	</group>
	<group name="table" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{sectionKey}]]></expression>
		<groupHeader>
			<band height="22">
				<element kind="frame" x="0" y="2" width="786" height="18" backcolor="#E5E7EB" mode="Opaque">
					<printWhenExpression><![CDATA[!$P{HAS_POSTAGE}]]></printWhenExpression>
					<element kind="staticText" x="4" y="0" width="20" height="18" style="ColHeader" hTextAlign="Right" vTextAlign="Middle">
						<text><![CDATA[#]]></text>
					</element>
					<element kind="staticText" x="32" y="0" width="36" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
						<text><![CDATA[INDEX]]></text>
					</element>
					<element kind="staticText" x="76" y="0" width="132" height="18" style="ColHeader" hTextAlign="Left" vTextAlign="Middle">
