<?xml version="1.0" encoding="UTF-8"?>
<!--
  RPT-02 Student Payment Report (spec docs/specs/student-payment-report.md section 1 PDF reference,
  section 5 grouping). Landscape A4. Application-owned template: no scriptlets, no SQL, no
  arithmetic - every value (KPIs, summary lines, group subtotals, cells) is a display string
  precomputed from the stored report run. Two column layouts (with / without the POSTAGE
  column) are selected by HAS_POSTAGE. Generated layout - keep both layouts in step.
-->
<jasperReport name="student-payment-report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786"
		leftMargin="28" rightMargin="28" topMargin="20" bottomMargin="20"
		whenNoDataType="AllSectionsNoDetail">
	<property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks.lms" value="sinhala,tamil"/>
	<style name="Base" default="true" fontName="LMS Sans" fontSize="8.5" forecolor="#1F2937"/>
	<style name="Muted" fontName="LMS Sans" fontSize="8.0" forecolor="#4B5563"/>
	<style name="CardLabel" fontName="LMS Sans" fontSize="8.0" forecolor="#6B7280" bold="true"/>
	<style name="CardValue" fontName="LMS Sans" fontSize="14.0" forecolor="#111827" bold="true"/>
	<style name="ColHeader" fontName="LMS Sans" fontSize="8.0" forecolor="#374151" bold="true"/>
	<parameter name="INSTITUTE" class="java.lang.String"/>
	<parameter name="FILTER_COURSES" class="java.lang.String"/>
	<parameter name="FILTER_LINE" class="java.lang.String"/>
	<parameter name="GENERATED_LINE" class="java.lang.String"/>
	<parameter name="FOOTER_TEXT" class="java.lang.String"/>
	<parameter name="NOTES" class="java.lang.String"/>
	<parameter name="EMPTY" class="java.lang.Boolean"/>
	<parameter name="HAS_POSTAGE" class="java.lang.Boolean"/>
	<field name="sectionKey" class="java.lang.String"/>
	<field name="sectionTitle" class="java.lang.String"/>
	<field name="kpiTotal" class="java.lang.String"/>
	<field name="kpiStudents" class="java.lang.String"/>
	<field name="kpiPayments" class="java.lang.String"/>
	<field name="summaryLines" class="java.lang.String"/>
	<field name="amountHeader" class="java.lang.String"/>
	<field name="g1Key" class="java.lang.String"/>
	<field name="g1Title" class="java.lang.String"/>
	<field name="g1Label" class="java.lang.String"/>
	<field name="g1Amount" class="java.lang.String"/>
	<field name="g1Fee" class="java.lang.String"/>
	<field name="g1Postage" class="java.lang.String"/>
	<field name="g2Key" class="java.lang.String"/>
	<field name="g2Title" class="java.lang.String"/>
	<field name="g2Label" class="java.lang.String"/>
	<field name="g2Amount" class="java.lang.String"/>
	<field name="g2Fee" class="java.lang.String"/>
	<field name="g2Postage" class="java.lang.String"/>
	<field name="rowNo" class="java.lang.String"/>
