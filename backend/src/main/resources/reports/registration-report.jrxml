<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="registration-report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="22" bottomMargin="22" whenNoDataType="AllSectionsNoDetail">
 <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks.lms" value="sinhala,tamil"/>
 <style name="Base" default="true" fontName="LMS Sans" fontSize="8.2" forecolor="#1F2937"/>
 <style name="Muted" fontName="LMS Sans" fontSize="8" forecolor="#4B5563"/>
 <style name="Header" fontName="LMS Sans" fontSize="7.5" forecolor="#374151" bold="true"/>
 <parameter name="REPORT_TITLE" class="java.lang.String"/><parameter name="INSTITUTE" class="java.lang.String"/><parameter name="DATE_RANGE" class="java.lang.String"/><parameter name="COURSES" class="java.lang.String"/><parameter name="OPERATOR" class="java.lang.String"/><parameter name="METHOD" class="java.lang.String"/><parameter name="GENERATED" class="java.lang.String"/><parameter name="TOTAL" class="java.lang.String"/><parameter name="FOOTER" class="java.lang.String"/><parameter name="EMPTY" class="java.lang.Boolean"/>
 <field name="rowNo" class="java.lang.String"/><field name="indexNumber" class="java.lang.String"/><field name="studentName" class="java.lang.String"/><field name="mobile" class="java.lang.String"/><field name="courses" class="java.lang.String"/><field name="registeredBy" class="java.lang.String"/><field name="lastPayment" class="java.lang.String"/><field name="registrationDate" class="java.lang.String"/>
 <title height="120"><element kind="rectangle" x="0" y="0" width="786" height="50" backcolor="#1F2937" mode="Opaque"><pen lineWidth="0.0"/></element><element kind="textField" x="14" y="6" width="750" height="38" forecolor="#FFFFFF" fontName="LMS Sans" fontSize="15" bold="true" textAdjust="StretchHeight"><expression><![CDATA[$P{REPORT_TITLE} + "\n" + $P{INSTITUTE}]]></expression></element><element kind="textField" x="0" y="57" width="380" height="13" style="Muted"><expression><![CDATA["Date range: " + $P{DATE_RANGE}]]></expression></element><element kind="textField" x="395" y="57" width="391" height="13" style="Muted" textAdjust="ScaleFont"><expression><![CDATA["Courses: " + $P{COURSES}]]></expression></element><element kind="textField" x="0" y="74" width="380" height="13" style="Muted"><expression><![CDATA["Operator: " + $P{OPERATOR} + "   |   Method: " + $P{METHOD}]]></expression></element><element kind="textField" x="395" y="74" width="391" height="13" style="Muted"><expression><![CDATA[$P{GENERATED}]]></expression></element><element kind="frame" x="0" y="94" width="185" height="26" backcolor="#F9FAFB" mode="Opaque"><element kind="staticText" x="8" y="4" width="169" height="10" style="Header"><text><![CDATA[TOTAL REGISTRATIONS]]></text></element><element kind="textField" x="8" y="13" width="169" height="12" fontName="LMS Sans" fontSize="12" bold="true"><expression><![CDATA[$P{TOTAL}]]></expression></element></element></title>
 <columnHeader height="24"><element kind="frame" x="0" y="2" width="786" height="20" backcolor="#E5E7EB" mode="Opaque"><element kind="staticText" x="3" y="1" width="24" height="18" style="Header" hTextAlign="Right"><text><![CDATA[#]]></text></element><element kind="staticText" x="35" y="1" width="48" height="18" style="Header"><text><![CDATA[INDEX]]></text></element><element kind="staticText" x="88" y="1" width="155" height="18" style="Header"><text><![CDATA[STUDENT NAME]]></text></element><element kind="staticText" x="248" y="1" width="110" height="18" style="Header"><text><![CDATA[MOBILE]]></text></element><element kind="staticText" x="363" y="1" width="155" height="18" style="Header"><text><![CDATA[COURSES]]></text></element><element kind="staticText" x="523" y="1" width="95" height="18" style="Header"><text><![CDATA[REGISTERED BY]]></text></element><element kind="staticText" x="623" y="1" width="70" height="18" style="Header"><text><![CDATA[LAST PAYMENT]]></text></element><element kind="staticText" x="698" y="1" width="84" height="18" style="Header"><text><![CDATA[DATE]]></text></element></element></columnHeader>
 <detail><band height="24" splitType="Stretch"><element kind="frame" x="0" y="0" width="786" height="24"><box><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><element kind="textField" x="3" y="1" width="24" height="20" hTextAlign="Right"><expression><![CDATA[$F{rowNo}]]></expression></element><element kind="textField" x="35" y="1" width="48" height="20" textAdjust="ScaleFont"><expression><![CDATA[$F{indexNumber}]]></expression></element><element kind="textField" x="88" y="1" width="155" height="20" textAdjust="StretchHeight"><expression><![CDATA[$F{studentName}]]></expression></element><element kind="textField" x="248" y="1" width="110" height="20" textAdjust="ScaleFont"><expression><![CDATA[$F{mobile}]]></expression></element><element kind="textField" x="363" y="1" width="155" height="20" textAdjust="StretchHeight"><expression><![CDATA[$F{courses}]]></expression></element><element kind="textField" x="523" y="1" width="95" height="20" textAdjust="ScaleFont"><expression><![CDATA[$F{registeredBy}]]></expression></element><element kind="textField" x="623" y="1" width="70" height="20"><expression><![CDATA[$F{lastPayment}]]></expression></element><element kind="textField" x="698" y="1" width="84" height="20"><expression><![CDATA[$F{registrationDate}]]></expression></element></element></band></detail>
 <pageFooter height="25"><element kind="line" x="0" y="2" width="786" height="1" forecolor="#D1D5DB"/><element kind="textField" x="0" y="8" width="650" height="12" style="Muted" textAdjust="ScaleFont"><expression><![CDATA[$P{FOOTER}]]></expression></element><element kind="textField" x="660" y="8" width="126" height="12" style="Muted" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression></element></pageFooter>
 <summary height="30"><element kind="staticText" x="0" y="8" width="786" height="14" forecolor="#6B7280" fontName="LMS Sans" fontSize="10" hTextAlign="Center"><printWhenExpression><![CDATA[$P{EMPTY}]]></printWhenExpression><text><![CDATA[No registrations match these filters]]></text></element></summary>
</jasperReport>
