<?xml version="1.0" encoding="UTF-8"?>
<!-- Student Behavior Report. Display-only typed-bean template: no SQL or classification logic. -->
<jasperReport name="student-behavior-report" pageWidth="595" pageHeight="842" columnWidth="539" leftMargin="28" rightMargin="28" topMargin="22" bottomMargin="22" whenNoDataType="AllSectionsNoDetail">
  <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks.lms" value="sinhala,tamil"/>
  <style name="Base" default="true" fontName="LMS Sans" fontSize="8.5" forecolor="#1F2937"/>
  <style name="Muted" fontName="LMS Sans" fontSize="8" forecolor="#4B5563"/>
  <style name="Header" fontName="LMS Sans" fontSize="8" forecolor="#374151" bold="true"/>
  <style name="KpiLabel" fontName="LMS Sans" fontSize="7.5" forecolor="#6B7280" bold="true"/>
  <style name="KpiValue" fontName="LMS Sans" fontSize="13" forecolor="#111827" bold="true"/>
  <parameter name="INSTITUTE" class="java.lang.String"/><parameter name="COURSE" class="java.lang.String"/><parameter name="MONTH" class="java.lang.String"/><parameter name="GENERATED" class="java.lang.String"/><parameter name="NEW_COUNT" class="java.lang.String"/><parameter name="DROPPED_COUNT" class="java.lang.String"/><parameter name="CONTINUING_COUNT" class="java.lang.String"/><parameter name="FOOTER" class="java.lang.String"/><parameter name="EMPTY" class="java.lang.Boolean"/>
  <field name="category" class="java.lang.String"/><field name="rowNo" class="java.lang.String"/><field name="indexNumber" class="java.lang.String"/><field name="studentName" class="java.lang.String"/><field name="mobile" class="java.lang.String"/>
  <group name="Category" keepTogether="true"><expression><![CDATA[$F{category}]]></expression><groupHeader><band height="28"><element kind="textField" x="0" y="10" width="539" height="16" fontSize="11" bold="true"><expression><![CDATA[$F{category}]]></expression></element></band></groupHeader></group>
  <title height="160"><element kind="rectangle" x="0" y="0" width="539" height="54" backcolor="#1F2937" mode="Opaque"><pen lineWidth="0"/></element><element kind="staticText" x="14" y="6" width="511" height="22" forecolor="#FFFFFF" fontSize="16" bold="true" vTextAlign="Middle"><text><![CDATA[Student Behaviour Report]]></text></element><element kind="textField" x="14" y="30" width="511" height="16" forecolor="#D1D5DB" fontSize="10" vTextAlign="Middle" textAdjust="ScaleFont"><expression><![CDATA[$P{INSTITUTE}]]></expression></element><element kind="textField" x="0" y="60" width="539" height="13" style="Muted" textAdjust="ScaleFont"><expression><![CDATA["Course: " + $P{COURSE}]]></expression></element><element kind="textField" x="0" y="76" width="260" height="13" style="Muted"><expression><![CDATA["Month: " + $P{MONTH}]]></expression></element><element kind="textField" x="0" y="92" width="539" height="13" style="Muted"><expression><![CDATA[$P{GENERATED}]]></expression></element><element kind="frame" x="0" y="114" width="168" height="42" backcolor="#F9FAFB" mode="Opaque"><box><leftPen lineWidth="3" lineColor="#2563EB"/></box><element kind="staticText" x="9" y="5" width="150" height="12" style="KpiLabel"><text><![CDATA[NEW STUDENTS]]></text></element><element kind="textField" x="9" y="18" width="150" height="20" style="KpiValue"><expression><![CDATA[$P{NEW_COUNT}]]></expression></element></element><element kind="frame" x="185" y="114" width="168" height="42" backcolor="#F9FAFB" mode="Opaque"><box><leftPen lineWidth="3" lineColor="#DC2626"/></box><element kind="staticText" x="9" y="5" width="150" height="12" style="KpiLabel"><text><![CDATA[DROPPED STUDENTS]]></text></element><element kind="textField" x="9" y="18" width="150" height="20" style="KpiValue"><expression><![CDATA[$P{DROPPED_COUNT}]]></expression></element></element><element kind="frame" x="370" y="114" width="169" height="42" backcolor="#F9FAFB" mode="Opaque"><box><leftPen lineWidth="3" lineColor="#059669"/></box><element kind="staticText" x="9" y="5" width="151" height="12" style="KpiLabel"><text><![CDATA[CONTINUING STUDENTS]]></text></element><element kind="textField" x="9" y="18" width="151" height="20" style="KpiValue"><expression><![CDATA[$P{CONTINUING_COUNT}]]></expression></element></element></title>
  <columnHeader height="22"><element kind="frame" x="0" y="2" width="539" height="18" backcolor="#E5E7EB" mode="Opaque"><element kind="staticText" x="4" y="0" width="24" height="18" style="Header" hTextAlign="Right" vTextAlign="Middle"><text><![CDATA[#]]></text></element><element kind="staticText" x="34" y="0" width="60" height="18" style="Header" vTextAlign="Middle"><text><![CDATA[INDEX]]></text></element><element kind="staticText" x="100" y="0" width="280" height="18" style="Header" vTextAlign="Middle"><text><![CDATA[STUDENT NAME]]></text></element><element kind="staticText" x="386" y="0" width="145" height="18" style="Header" vTextAlign="Middle"><text><![CDATA[MOBILE]]></text></element></element></columnHeader>
  <detail><band height="20" splitType="Prevent"><element kind="frame" x="0" y="0" width="539" height="20"><box><bottomPen lineWidth="0.5" lineColor="#E5E7EB"/></box><element kind="textField" x="4" y="1" width="24" height="18" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{rowNo}]]></expression></element><element kind="textField" x="34" y="1" width="60" height="18" vTextAlign="Middle" textAdjust="ScaleFont"><expression><![CDATA[$F{indexNumber}]]></expression></element><element kind="textField" x="100" y="1" width="280" height="18" vTextAlign="Middle" textAdjust="ScaleFont"><expression><![CDATA[$F{studentName}]]></expression></element><element kind="textField" x="386" y="1" width="145" height="18" vTextAlign="Middle" textAdjust="ScaleFont"><expression><![CDATA[$F{mobile}]]></expression></element></element></band></detail>
  <pageFooter height="25"><element kind="line" x="0" y="2" width="539" height="1" forecolor="#D1D5DB"/><element kind="textField" x="0" y="8" width="415" height="12" style="Muted" textAdjust="ScaleFont"><expression><![CDATA[$P{FOOTER}]]></expression></element><element kind="textField" x="420" y="8" width="119" height="12" style="Muted" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression></element></pageFooter>
  <summary height="30"><element kind="staticText" x="0" y="7" width="539" height="14" forecolor="#6B7280" fontSize="10" hTextAlign="Center"><printWhenExpression><![CDATA[$P{EMPTY}]]></printWhenExpression><text><![CDATA[No students match these filters]]></text></element></summary>
</jasperReport>
