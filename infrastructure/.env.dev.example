POSTGRES_DB=lms_dev
POSTGRES_USER=lms_app
POSTGRES_PASSWORD=change_this_local_password

MINIO_ROOT_USER=lms_minio
MINIO_ROOT_PASSWORD=change_this_local_password

# Backend object-storage adapter (S3ObjectStorageApi) - dev points these at
# the MinIO service provisioned above. Credentials are NOT redeclared here:
# the backend's "local" Spring profile (application-local.yml) defaults
# object-storage.access-key/secret-key to MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# above, matching the one MinIO instance this compose file provisions.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=lms-dev
